@page
@model SmartRental.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
    <div class="auth-shell">
        <aside class="auth-brand-panel">
            <a class="auth-logo" asp-controller="Home" asp-action="Index"><span class="brand-mark">SR</span> SmartRental</a>
            <div class="auth-brand-copy">
                <span class="auth-kicker"><i class="bi bi-stars"></i> Không gian sống phù hợp</span>
                <h1>Tìm phòng thông minh cùng SmartRental</h1>
                <p>Mọi công cụ bạn cần để tìm, trao đổi và đặt lịch xem phòng trong một trải nghiệm liền mạch.</p>
                <ul class="auth-benefits">
                    <li><i class="bi bi-check-circle-fill"></i> Tìm phòng nhanh</li>
                    <li><i class="bi bi-check-circle-fill"></i> Lọc theo giá và diện tích</li>
                    <li><i class="bi bi-check-circle-fill"></i> Nhắn tin với chủ trọ</li>
                    <li><i class="bi bi-check-circle-fill"></i> Đặt lịch xem phòng</li>
                </ul>
            </div>
        </aside>
        <section class="auth-form-panel" aria-labelledby="login-title">
            <div class="auth-form-heading">
                <span class="eyebrow">CHÀO MỪNG TRỞ LẠI</span>
                <h2 id="login-title">Đăng nhập</h2>
                <p>Tiếp tục hành trình tìm nơi ở phù hợp với bạn.</p>
            </div>
            <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <div class="auth-input"><i class="bi bi-envelope"></i><input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="ban@example.com" autofocus /></div>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between gap-3"><label asp-for="Input.Password" class="form-label"></label><a asp-page="./ForgotPassword" class="small fw-semibold">Quên mật khẩu?</a></div>
                    <div class="auth-input"><i class="bi bi-lock"></i><input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu" /></div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>
                <label class="form-check mb-4"><input asp-for="Input.RememberMe" class="form-check-input" /><span class="form-check-label">Ghi nhớ đăng nhập</span></label>
                <button type="submit" class="sr-btn sr-btn-primary w-100"><i class="bi bi-box-arrow-in-right"></i> Đăng nhập</button>
            </form>
            <p class="auth-switch">Chưa có tài khoản? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Đăng ký miễn phí</a></p>
        </section>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
