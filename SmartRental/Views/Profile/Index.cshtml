@model SmartRental.ViewModels.Profile.ProfileViewModel
@{ ViewData["Title"] = "Hồ sơ cá nhân"; }
<div class="row justify-content-center mt-2"><div class="col-md-8 col-lg-6">
@if (TempData["SuccessMessage"] is string message) { <div class="alert alert-success" role="alert">@message</div> }
<div class="card"><div class="card-body p-4"><div class="d-flex align-items-center gap-3 mb-4"><div class="profile-avatar">@((Model.HoTen ?? Model.Email ?? "SR").Substring(0, 1).ToUpper())</div><div><h2 class="h4 fw-bold mb-1">Hồ sơ cá nhân</h2><p class="text-muted mb-0">Quản lý thông tin tài khoản của bạn</p></div></div><dl class="row mb-4 profile-list">
<dt class="col-sm-4">Họ tên</dt><dd class="col-sm-8">@(Model.HoTen ?? "Chưa cập nhật")</dd><dt class="col-sm-4">Email</dt><dd class="col-sm-8">@(Model.Email ?? "Chưa cập nhật")</dd><dt class="col-sm-4">Số điện thoại</dt><dd class="col-sm-8">@(Model.PhoneNumber ?? "Chưa cập nhật")</dd><dt class="col-sm-4">Địa chỉ</dt><dd class="col-sm-8">@(Model.DiaChi ?? "Chưa cập nhật")</dd><dt class="col-sm-4">Vai trò</dt><dd class="col-sm-8">@(Model.Roles.Any() ? string.Join(", ", Model.Roles) : "Chưa có vai trò")</dd>
</dl><div class="d-flex flex-wrap gap-2"><a asp-action="Edit" class="btn btn-primary">Chỉnh sửa</a><a asp-action="ChangePassword" class="btn btn-outline-secondary">Đổi mật khẩu</a></div></div></div></div></div>
