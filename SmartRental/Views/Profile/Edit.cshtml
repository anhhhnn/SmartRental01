@model SmartRental.ViewModels.Profile.EditProfileViewModel
@{
	ViewData["Title"] = "Chỉnh sửa hồ sơ";
}
<div class="container page-container profile-page">
	<div class="profile-shell">
		<div class="card profile-card">
			<div class="card-body p-4">
				<div class="profile-form-heading"><span class="eyebrow">TÀI KHOẢN</span><h1 class="h4 fw-bold mb-1">Chỉnh sửa hồ sơ</h1><p>Cập nhật thông tin để chủ trọ và người thuê dễ dàng liên hệ.</p></div>
				<form asp-action="Edit" method="post">
					<div asp-validation-summary="ModelOnly" class="text-danger"></div>
					<div class="mb-3">
						<label asp-for="HoTen" class="form-label"></label>
						<input asp-for="HoTen" class="form-control" />
						<span asp-validation-for="HoTen" class="text-danger"></span>
					</div>
					<div class="mb-3">
						<label class="form-label">Email</label>
						<input value="@Model.Email" class="form-control" readonly />
					</div>
					<div class="mb-3">
						<label asp-for="PhoneNumber" class="form-label"></label>
						<input asp-for="PhoneNumber" class="form-control" />
						<span asp-validation-for="PhoneNumber" class="text-danger"></span>
					</div>
					<div class="mb-4">
						<label asp-for="DiaChi" class="form-label"></label>
						<textarea asp-for="DiaChi" class="form-control" rows="3"></textarea>
						<span asp-validation-for="DiaChi" class="text-danger"></span>
					</div>
					<div class="form-actions"><button type="submit" class="sr-btn sr-btn-primary">Lưu thay đổi</button><a asp-action="Index" class="sr-btn sr-btn-secondary">Hủy</a></div>
				</form>
			</div>
		</div>
	</div>
</div>
@section Scripts
{
	<partial name="_ValidationScriptsPartial" />
}
