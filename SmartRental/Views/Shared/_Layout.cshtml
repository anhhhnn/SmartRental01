@using SmartRental.Security
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#173B6C" />
    <title>@ViewData["Title"] - SmartRental</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartRental.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Đi đến nội dung chính</a>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-smart fixed-top" aria-label="Điều hướng chính">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">SR</span><span>SmartRental</span></a>
                @if (User.IsInRole(AppRoles.Admin))
                {
                    var isAdminPage = Context.Request.Path.StartsWithSegments("/Admin");
                    <a class="navbar-admin-link @(isAdminPage ? "active" : "")"
                       asp-controller="Admin"
                       asp-action="Index"
                       title="Quản trị"
                       aria-label="Mở khu vực quản trị"
                       aria-current="@(isAdminPage ? "page" : null)">
                        <i class="bi bi-shield-lock" aria-hidden="true"></i>
                        <span class="navbar-admin-text">Quản trị</span>
                    </a>
                }
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Mở điều hướng"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Phongtro" asp-action="Index">Tìm phòng</a></li>
                        <li class="nav-item"><a class="nav-link disabled" href="#" aria-disabled="true" title="Sẽ sớm được tích hợp"><i class="bi bi-stars"></i> Gợi ý AI</a></li>
                        @if (User.Identity?.IsAuthenticated == true) { <li class="nav-item"><a class="nav-link" asp-controller="Phongtro" asp-action="YeuThichCuaToi"><i class="bi bi-heart"></i> Yêu thích</a></li> }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <main id="main-content" class="site-main" role="main">@RenderBody()</main>
    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand"><a asp-controller="Home" asp-action="Index"><span class="brand-mark">SR</span> SmartRental</a><p>Nền tảng tìm và quản lý phòng trọ rõ ràng, tiện lợi và đáng tin cậy.</p></div>
                <div><h2>Liên kết nhanh</h2><a asp-controller="Home" asp-action="Index">Trang chủ</a><a asp-controller="Phongtro" asp-action="Index">Tìm phòng</a></div>
                <div><h2>Hỗ trợ</h2><a asp-controller="Home" asp-action="Privacy">Quyền riêng tư</a><a asp-controller="Messages" asp-action="Index">Tin nhắn</a></div>
                <div><h2>Liên hệ</h2><span><i class="bi bi-envelope"></i> support@smartrental.vn</span><span><i class="bi bi-geo-alt"></i> Việt Nam</span></div>
            </div>
            <div class="footer-bottom"><span>© 2026 SmartRental. All rights reserved.</span><span>Không gian phù hợp, quyết định thông minh.</span></div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
