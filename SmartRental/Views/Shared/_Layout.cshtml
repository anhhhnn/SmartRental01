@using SmartRental.Security
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>@ViewData["Title"] - SmartRental</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><link rel="stylesheet" href="~/SmartRental.styles.css" asp-append-version="true" /></head><body><header><nav class="navbar navbar-expand-lg navbar-smart sticky-top"><div class="container"><a class="navbar-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">SR</span>SmartRental</a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Mở điều hướng"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="mainNavbar"><ul class="navbar-nav mx-auto mb-2 mb-lg-0"><li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li><li class="nav-item"><a class="nav-link" asp-controller="Phongtro" asp-action="Index">Tìm phòng</a></li><li class="nav-item"><a class="nav-link disabled" href="#" aria-disabled="true" title="Sẽ sớm được tích hợp">Gợi ý AI</a></li>@if(User.Identity?.IsAuthenticated==true){<li class="nav-item"><a class="nav-link" asp-controller="Phongtro" asp-action="YeuThichCuaToi"><i class="bi bi-heart me-1"></i>Yêu thích</a></li>}</ul><partial name="_LoginPartial" /></div></div></nav></header><main class="site-main" role="main">@RenderBody()</main><footer class="site-footer py-4"><div class="container d-md-flex justify-content-between align-items-center gap-3"><div><div class="fw-bold text-white">SmartRental</div><small>Nền tảng tìm và quản lý phòng trọ đơn giản, đáng tin cậy.</small></div><small>© 2026 SmartRental. All rights reserved.</small></div></footer><script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
