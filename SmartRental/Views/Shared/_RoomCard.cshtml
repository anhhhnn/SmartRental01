@model SmartRental.Models.Phongtro
@{ var fav=(ViewData["Favorite"] as bool?) ?? false;var manage=(ViewData["Manage"] as bool?) ?? false;var showFav=(ViewData["ShowFavorite"] as bool?) ?? false;var ret=Context.Request.Path+Context.Request.QueryString;var amenities=Model.PhongTienNghis?.ToList()??new();var ratings=Model.DanhGias??new List<SmartRental.Models.DanhGia>();var ratingCount=ratings.Count;var averageRating=ratingCount==0?0:ratings.Average(x=>x.SoSao);var image=Model.HinhAnhs.OrderBy(x=>x.ThuTu).FirstOrDefault(x=>x.IsAnhChinh)?.DuongDan??Model.HinhAnhs.OrderBy(x=>x.ThuTu).FirstOrDefault()?.DuongDan??Model.HinhAnh;}
<article class="card room-card d-flex flex-column">
    <div class="room-card__media position-relative">
        <a asp-controller="Phongtro" asp-action="Details" asp-route-id="@Model.Id" aria-label="Xem @Model.TieuDe">@if(!string.IsNullOrWhiteSpace(image)){<img src="@image" alt="@Model.TieuDe" class="room-card__image" loading="lazy"/>}else{<div class="room-image-placeholder"><i class="bi bi-image"></i><span>Chưa có hình ảnh</span></div>}</a>
        <span class="status-badge @(Model.SoLuongPhong>0?"status-active":"status-hidden") position-absolute top-0 start-0 m-3">@(Model.SoLuongPhong>0?$"Còn {Model.SoLuongPhong} phòng":"Hết phòng")</span>
        @if(showFav){<form asp-controller="Phongtro" asp-action="@(fav?"RemoveYeuThich":"AddYeuThich")" method="post" class="position-absolute top-0 end-0 m-2"><input type="hidden" name="phongtroId" value="@Model.Id"/><input type="hidden" name="returnUrl" value="@ret"/><button class="room-favorite" type="submit" aria-label="@(fav ? "Bỏ yêu thích" : "Thêm vào yêu thích")"><i class="bi bi-heart@(fav?"-fill":"")"></i></button></form>}
    </div>
    <div class="card-body d-flex flex-column">
        <div class="room-card__topline"><span><i class="bi bi-aspect-ratio"></i> @Model.DienTich m²</span>@if(ratingCount>0){<span class="room-rating"><i class="bi bi-star-fill"></i> @averageRating.ToString("0.0") <small>(@ratingCount)</small></span>}</div>
        <h3 class="h5 room-card__title"><a asp-controller="Phongtro" asp-action="Details" asp-route-id="@Model.Id">@Model.TieuDe</a></h3>
        <p class="room-meta"><i class="bi bi-person"></i><span>@Model.SoNguoiToiDa người</span></p>
        <p class="room-meta"><i class="bi bi-geo-alt"></i><span>@Model.DiaChi</span></p>
        @if(amenities.Any()){<div class="room-amenities">@foreach(var amenity in amenities.Take(3)){<span class="amenity-chip">@amenity.TienNghi.TenTienNghi</span>}@if(amenities.Count>3){<span class="amenity-chip">+@(amenities.Count-3)</span>}</div>}
        <div class="room-card__footerline mt-auto"><div><small>Từ</small><div class="room-card__price">@Model.Gia.ToString("N0") ₫<span>/tháng</span></div></div><a asp-controller="Phongtro" asp-action="Details" asp-route-id="@Model.Id" class="sr-btn sr-btn-secondary sr-btn-sm">Chi tiết <i class="bi bi-arrow-right"></i></a></div>
        @if(manage){<div class="room-manage-actions"><a asp-controller="Phongtro" asp-action="Edit" asp-route-id="@Model.Id" class="sr-btn sr-btn-ghost sr-btn-sm"><i class="bi bi-pencil"></i> Sửa</a><a asp-controller="Phongtro" asp-action="Delete" asp-route-id="@Model.Id" class="sr-btn sr-btn-ghost sr-btn-sm text-danger"><i class="bi bi-trash"></i> Xóa</a></div>}
    </div>
</article>
