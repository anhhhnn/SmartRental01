@model SmartRental.Models.Phongtro
@{ var fav=(ViewData["Favorite"] as bool?) ?? false;var manage=(ViewData["Manage"] as bool?) ?? false;var showFav=(ViewData["ShowFavorite"] as bool?) ?? false;var ret=Context.Request.Path+Context.Request.QueryString;var amenities=Model.PhongTienNghis?.ToList()??new();var ratings=Model.DanhGias??new List<SmartRental.Models.DanhGia>();var ratingCount=ratings.Count;var averageRating=ratingCount==0?0:ratings.Average(x=>x.SoSao);var image=Model.HinhAnhs.OrderBy(x=>x.ThuTu).FirstOrDefault(x=>x.IsAnhChinh)?.DuongDan??Model.HinhAnhs.OrderBy(x=>x.ThuTu).FirstOrDefault()?.DuongDan??Model.HinhAnh;}
<article class="card room-card d-flex flex-column"><div class="room-card__media position-relative"><a asp-controller="Phongtro" asp-action="Details" asp-route-id="@Model.Id">@if(!string.IsNullOrWhiteSpace(image)){<img src="@image" alt="@Model.TieuDe" class="room-card__image"/>}else{<div class="room-image-placeholder d-flex align-items-center justify-content-center text-muted">Chưa có hình ảnh</div>}</a><span class="status-badge @(Model.SoLuongPhong>0?"status-active":"status-hidden") position-absolute top-0 start-0 m-3">@(Model.SoLuongPhong>0?$"Còn phòng ({Model.SoLuongPhong} phòng)":"Hết phòng")</span>@if(showFav){<form asp-controller="Phongtro" asp-action="@(fav?"RemoveYeuThich":"AddYeuThich")" method="post" class="position-absolute top-0 end-0 m-2"><input type="hidden" name="phongtroId" value="@Model.Id"/><input type="hidden" name="returnUrl" value="@ret"/><button class="room-favorite" type="submit"><i class="bi bi-heart@(fav?"-fill":"")"></i></button></form>}</div><div class="card-body d-flex flex-column"><h3 class="h5 room-card__title">@Model.TieuDe</h3><div class="room-card__price mb-2">@Model.Gia.ToString("N0") VNĐ/tháng</div><p class="room-meta mb-3">@Model.DiaChi</p></div><div class="card-footer bg-white border-0 pt-0"><a asp-controller="Phongtro" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary w-100">Xem chi tiết</a></div></article>
