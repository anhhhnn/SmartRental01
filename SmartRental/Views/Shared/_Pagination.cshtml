@{
    var pageNumber = (int)(ViewBag.PageNumber ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var hasPreviousPage = (bool)(ViewBag.HasPreviousPage ?? false);
    var hasNextPage = (bool)(ViewBag.HasNextPage ?? false);
    string BuildPageUrl(int page)
    {
        var parameters = new List<string>();
        foreach (var query in Context.Request.Query.Where(q => !string.Equals(q.Key, "page", StringComparison.OrdinalIgnoreCase)))
        {
            foreach (var value in query.Value)
            {
                parameters.Add($"{Uri.EscapeDataString(query.Key)}={Uri.EscapeDataString(value ?? string.Empty)}");
            }
        }
        parameters.Add($"page={page}");
        return $"{Context.Request.Path}?{string.Join("&", parameters)}";
    }
}
@if (totalPages > 1)
{
    <nav aria-label="Phân trang" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(!hasPreviousPage ? "disabled" : "")">
                @if (hasPreviousPage)
                {
                    <a class="page-link" href="@BuildPageUrl(pageNumber - 1)" rel="prev" aria-label="Trang trước">Trước</a>
                }
                else
                {
                    <span class="page-link" aria-disabled="true">Trước</span>
                }
            </li>
            @{
                var firstVisiblePage = Math.Max(2, pageNumber - 2);
                var lastVisiblePage = Math.Min(totalPages - 1, pageNumber + 2);
            }
            <li class="page-item @(pageNumber == 1 ? "active" : "")">
                <a class="page-link" href="@BuildPageUrl(1)" aria-current="@(pageNumber == 1 ? "page" : null)">1</a>
            </li>
            @if (firstVisiblePage > 2)
            {
                <li class="page-item page-item-ellipsis disabled" aria-hidden="true">
                    <span class="page-link">&hellip;</span>
                </li>
            }
            @for (var number = firstVisiblePage; number <= lastVisiblePage; number++)
            {
                <li class="page-item @(number == pageNumber ? "active" : "")">
                    <a class="page-link" href="@BuildPageUrl(number)" aria-current="@(pageNumber == number ? "page" : null)">@number</a>
                </li>
            }
            @if (lastVisiblePage < totalPages - 1)
            {
                <li class="page-item page-item-ellipsis disabled" aria-hidden="true">
                    <span class="page-link">&hellip;</span>
                </li>
            }
            @if (totalPages > 1)
            {
                <li class="page-item @(pageNumber == totalPages ? "active" : "")">
                    <a class="page-link" href="@BuildPageUrl(totalPages)" aria-current="@(pageNumber == totalPages ? "page" : null)">@totalPages</a>
                </li>
            }
            <li class="page-item @(!hasNextPage ? "disabled" : "")">
                @if (hasNextPage)
                {
                    <a class="page-link" href="@BuildPageUrl(pageNumber + 1)" rel="next" aria-label="Trang sau">Sau</a>
                }
                else
                {
                    <span class="page-link" aria-disabled="true">Sau</span>
                }
            </li>
        </ul>
    </nav>
}
