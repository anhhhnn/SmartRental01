@model SmartRental.ViewModels.Account.EditProfileViewModel
@{ ViewData["Title"] = "Chỉnh sửa hồ sơ"; }
<div class="row justify-content-center mt-4"><div class="col-lg-7"><div class="card border-0 shadow-sm"><div class="card-header bg-white"><h3 class="mb-0">Chỉnh sửa hồ sơ</h3></div><div class="card-body"><form asp-action="EditProfile" method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label asp-for="HoTen" class="form-label"></label><input asp-for="HoTen" class="form-control" /><span asp-validation-for="HoTen" class="text-danger"></span></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" readonly /><div class="form-text">Email không thể thay đổi tại đây.</div></div><div class="mb-3"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" /><span asp-validation-for="PhoneNumber" class="text-danger"></span></div><div class="mb-4"><label asp-for="DiaChi" class="form-label"></label><textarea asp-for="DiaChi" class="form-control" rows="3"></textarea><span asp-validation-for="DiaChi" class="text-danger"></span></div><div class="d-flex gap-2"><a asp-action="Profile" class="btn btn-outline-secondary">Hủy</a><button type="submit" class="btn btn-primary">Lưu thay đổi</button></div></form></div></div></div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
