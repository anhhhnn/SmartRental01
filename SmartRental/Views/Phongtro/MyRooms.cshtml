@model IEnumerable<SmartRental.Models.Phongtro>

@{
    ViewData["Title"] = "Phòng của tôi";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Phòng của tôi</h2>
            <p class="text-muted mb-0">Danh sách phòng do tài khoản này đăng.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ Đăng phòng</a>
    </div>

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <a asp-action="Details" asp-route-id="@item.Id">
                            @if (!string.IsNullOrWhiteSpace(item.HinhAnh))
                            {
                                <img src="@item.HinhAnh"
                                     alt="@item.TieuDe"
                                     class="card-img-top"
                                     style="height:230px; object-fit:cover;" />
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center"
                                     style="height:230px;">
                                    <span class="text-muted">Chưa có hình ảnh</span>
                                </div>
                            }
                        </a>

                        <div class="card-body">
                            <div class="mb-2">
                                @if (item.TrangThai)
                                {
                                    <span class="badge bg-success">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Tạm ẩn</span>
                                }
                            </div>

                            <h5 class="card-title fw-bold">@item.TieuDe</h5>
                            <div class="text-danger fw-bold mb-2">
                                @item.Gia.ToString("N0") VNĐ/tháng
                            </div>
                            <p class="mb-1"><strong>Diện tích:</strong> @item.DienTich m²</p>
                            <p class="mb-0"><strong>Địa chỉ:</strong> @item.DiaChi</p>
                        </div>

                        <div class="card-footer bg-white border-0">
                            <div class="d-grid gap-2">
                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-primary">
                                    Xem chi tiết
                                </a>
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning flex-fill">
                                        Sửa
                                    </a>
                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-danger flex-fill">
                                        Xóa
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <h4 class="fw-bold">Bạn chưa đăng phòng nào</h4>
                <p class="text-muted">Tạo tin đăng đầu tiên để bắt đầu cho thuê.</p>
                <a asp-action="Create" class="btn btn-primary">Đăng phòng ngay</a>
            </div>
        </div>
    }
</div>

<partial name="_Pagination" />
