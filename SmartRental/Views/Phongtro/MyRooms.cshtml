@model IEnumerable<SmartRental.Models.Phongtro>
@{ ViewData["Title"] = "Phòng của tôi"; var rooms=Model.ToList(); var total=(int)(ViewBag.TotalRoomListings??0); var visible=(int)(ViewBag.VisibleRoomListings??0); var available=(int)(ViewBag.AvailableRoomUnits??0); }
<div class="container rooms-page-container page-container">
    <div class="page-heading page-heading--actions"><div><span class="eyebrow">QUẢN LÝ TIN ĐĂNG</span><h1>Phòng của tôi</h1><p>Theo dõi và cập nhật các phòng do bạn đăng.</p></div><a asp-action="Create" class="sr-btn sr-btn-accent"><i class="bi bi-house-add"></i> Đăng phòng mới</a></div>
    <div class="owner-stats"><div><i class="bi bi-houses"></i><span><strong>@total</strong>Tổng tin đăng</span></div><div><i class="bi bi-broadcast"></i><span><strong>@visible</strong>Tin đang hiển thị</span></div><div><i class="bi bi-door-open"></i><span><strong>@available</strong>Phòng còn trống</span></div></div>
    @if(rooms.Any()){<div class="room-grid">@foreach(var room in rooms){var data=new ViewDataDictionary(ViewData);data["Manage"]=true;<div class="room-grid__item"><partial name="_RoomCard" model="room" view-data="data"/></div>}</div><partial name="_Pagination"/>}else{var data=new ViewDataDictionary(ViewData);data["EmptyTitle"]="Bạn chưa đăng phòng nào";data["EmptyMessage"]="Tạo tin đăng đầu tiên với thông tin và hình ảnh rõ ràng.";data["EmptyActionUrl"]="/Phongtro/Create";data["EmptyActionText"]="Đăng phòng ngay";<partial name="_EmptyState" view-data="data"/>}
</div>
