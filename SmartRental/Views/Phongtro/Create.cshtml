@model SmartRental.Models.Phongtro
@{ ViewData["Title"] = "Đăng phòng trọ"; }
<div class="row justify-content-center mt-2 mb-5"><div class="col-lg-8"><div class="card"><div class="card-header"><h4 class="mb-0">Đăng phòng trọ mới</h4></div><div class="card-body">
<form asp-action="Create" method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="TieuDe" class="form-label">Tiêu đề</label><input asp-for="TieuDe" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="DiaChi" class="form-label">Địa chỉ</label><input asp-for="DiaChi" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="Gia" class="form-label">Giá phòng</label><input asp-for="Gia" class="form-control" min="0"/></div><div class="col-md-6 mb-3"><label asp-for="DienTich" class="form-label">Diện tích (m²)</label><input asp-for="DienTich" class="form-control" min="0"/></div></div>
<div class="mb-3"><label asp-for="MoTa" class="form-label">Mô tả</label><textarea asp-for="MoTa" class="form-control" rows="5"></textarea></div>
<div class="form-section mb-3"><div class="form-section__title mb-2">Tình trạng phòng</div><div class="d-flex gap-3 mb-2"><label class="form-check"><input class="form-check-input" type="radio" name="conPhong" value="true" checked/> Còn phòng</label><label class="form-check"><input class="form-check-input" type="radio" name="conPhong" value="false"/> Hết phòng</label></div><label asp-for="SoLuongPhong" class="form-label">Số lượng phòng còn trống</label><input asp-for="SoLuongPhong" id="roomCount" type="number" min="0" class="form-control"/><span asp-validation-for="SoLuongPhong" class="text-danger"></span></div>
<div class="mb-3"><label class="form-label">Tiện nghi</label><div class="row">@foreach (var x in ViewBag.TienNghis) { <div class="col-md-4"><label class="form-check"><input class="form-check-input" type="checkbox" name="tienNghiIds" value="@x.Id"/> @x.TenTienNghi</label></div> }</div></div>
<div class="form-section mb-4"><div class="form-section__title mb-2">Hình ảnh</div><input type="file" name="imageFiles" id="imageFiles" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" multiple/><div class="form-text">Tối đa 10 ảnh, mỗi ảnh tối đa 5MB (JPG, JPEG, PNG, WEBP).</div><div id="imagePreviews" class="image-preview-grid mt-3"></div></div>
<div class="d-flex justify-content-between"><a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a><button class="btn btn-primary">Đăng phòng</button></div></form>
</div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial"/><script>const input=document.querySelector('#imageFiles'),previews=document.querySelector('#imagePreviews'),count=document.querySelector('#roomCount');function availability(){const available=document.querySelector('[name=conPhong]:checked').value==='true';count.disabled=!available;if(!available)count.value=0;}document.querySelectorAll('[name=conPhong]').forEach(x=>x.onchange=availability);availability();input.onchange=()=>{previews.innerHTML='';[...input.files].slice(0,10).forEach(f=>{let img=document.createElement('img');img.src=URL.createObjectURL(f);img.className='image-preview-thumb';previews.append(img);});};</script> }
