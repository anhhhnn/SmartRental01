@model SmartRental.Models.Phongtro
@{ ViewData["Title"] = "Đăng phòng trọ"; }
<div class="container form-page">
    <div class="form-page__heading"><div><span class="eyebrow">DÀNH CHO CHỦ TRỌ</span><h1>Đăng phòng trọ mới</h1><p>Cung cấp thông tin rõ ràng để người thuê dễ dàng đưa ra quyết định.</p></div><a asp-action="MyRooms" class="sr-btn sr-btn-ghost"><i class="bi bi-arrow-left"></i> Phòng của tôi</a></div>
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="room-editor">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <section class="card editor-section"><div class="row g-3"><div class="col-md-6"><label asp-for="KhuVuc" class="form-label">Khu vực</label><select asp-for="KhuVuc" class="form-select"><option value="">Chọn khu vực</option>@foreach (var area in ThaiNguyenAreas.All) { <option value="@area">@area</option> }</select><span asp-validation-for="KhuVuc" class="text-danger small"></span></div></div></section>
        <section class="card editor-section"><div class="row g-3"><div class="col-md-4"><label asp-for="SoNguoiToiDa" class="form-label">Số người ở tối đa</label><input asp-for="SoNguoiToiDa" type="number" min="1" class="form-control"/><span asp-validation-for="SoNguoiToiDa" class="text-danger small"></span></div></div></section>
        <section class="card editor-section"><div class="editor-section__head"><span>1</span><div><h2>Thông tin cơ bản</h2><p>Tiêu đề ngắn gọn và địa chỉ cụ thể.</p></div></div><div class="row g-3"><div class="col-md-6"><label asp-for="TieuDe" class="form-label">Tiêu đề</label><input asp-for="TieuDe" class="form-control" placeholder="Ví dụ: Phòng trọ thoáng mát gần trường"/><span asp-validation-for="TieuDe" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="DiaChi" class="form-label">Địa chỉ</label><input asp-for="DiaChi" class="form-control" placeholder="Số nhà, đường, phường/xã..."/><span asp-validation-for="DiaChi" class="text-danger small"></span></div><div class="col-12"><label asp-for="MoTa" class="form-label">Mô tả</label><textarea asp-for="MoTa" class="form-control" rows="5" placeholder="Mô tả không gian, vị trí và những điểm nổi bật..."></textarea><span asp-validation-for="MoTa" class="text-danger small"></span></div></div></section>
        <section class="card editor-section"><div class="editor-section__head"><span>2</span><div><h2>Giá, diện tích & tình trạng</h2><p>Cập nhật chính xác để kết quả tìm kiếm phù hợp hơn.</p></div></div><div class="row g-3"><div class="col-md-4"><label asp-for="Gia" class="form-label">Giá phòng</label><div class="input-group"><input asp-for="Gia" class="form-control" min="400000"/><span class="input-group-text">VNĐ/tháng</span></div><span asp-validation-for="Gia" class="text-danger small"></span></div><div class="col-md-4"><label asp-for="DienTich" class="form-label">Diện tích</label><div class="input-group"><input asp-for="DienTich" class="form-control" min="10"/><span class="input-group-text">m²</span></div><span asp-validation-for="DienTich" class="text-danger small"></span></div><div class="col-md-4"><label asp-for="SoLuongPhong" class="form-label">Số phòng còn trống</label><input asp-for="SoLuongPhong" id="roomCount" type="number" min="0" class="form-control"/><span asp-validation-for="SoLuongPhong" class="text-danger small"></span></div></div><div class="availability-selector mt-3"><label><input type="radio" name="conPhong" value="true" checked/><span><i class="bi bi-check-circle"></i><strong>Còn phòng</strong><small>Hiển thị số lượng phòng trống</small></span></label><label><input type="radio" name="conPhong" value="false"/><span><i class="bi bi-x-circle"></i><strong>Hết phòng</strong><small>Tạm thời không nhận lịch xem</small></span></label></div></section>
        <section class="card editor-section"><div class="editor-section__head"><span>3</span><div><h2>Tiện nghi</h2><p>Chọn các tiện nghi hiện có tại phòng.</p></div></div><div class="amenity-selector">@foreach(var x in ViewBag.TienNghis){<label><input type="checkbox" name="tienNghiIds" value="@x.Id"/><span><i class="bi bi-check2"></i>@x.TenTienNghi</span></label>}</div></section>
        <section class="card editor-section"><div class="editor-section__head"><span>4</span><div><h2>Hình ảnh</h2><p>Tối đa 10 ảnh, mỗi ảnh không quá 5MB.</p></div></div><label class="upload-dropzone" for="imageFiles"><i class="bi bi-cloud-arrow-up"></i><strong>Chọn ảnh phòng</strong><span>JPG, PNG hoặc WEBP · có thể chọn nhiều ảnh</span><input type="file" name="imageFiles" id="imageFiles" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" multiple/></label><div id="imagePreviews" class="image-preview-grid mt-3" aria-live="polite"></div></section>
        <div class="editor-actions"><a asp-action="MyRooms" class="sr-btn sr-btn-secondary">Hủy</a><button class="sr-btn sr-btn-accent" type="submit"><i class="bi bi-check2-circle"></i> Đăng phòng</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial"/><script>const input=document.querySelector('#imageFiles'),previews=document.querySelector('#imagePreviews'),count=document.querySelector('#roomCount');function availability(){const available=document.querySelector('[name=conPhong]:checked').value==='true';count.disabled=!available;if(!available)count.value=0;}document.querySelectorAll('[name=conPhong]').forEach(x=>x.addEventListener('change',availability));availability();input.addEventListener('change',()=>{previews.innerHTML='';[...input.files].slice(0,10).forEach((file,index)=>{const item=document.createElement('div');item.className='image-preview-item';const img=document.createElement('img');img.src=URL.createObjectURL(file);img.alt=`Ảnh xem trước ${index+1}`;img.className='image-preview-thumb';const label=document.createElement('span');label.textContent=index===0?'Ảnh chính':`Ảnh ${index+1}`;item.append(img,label);previews.append(item);});});</script> }
