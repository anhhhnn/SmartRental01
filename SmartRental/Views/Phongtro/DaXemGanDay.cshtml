@model IEnumerable<SmartRental.Models.LichSuXem>

@{
    ViewData["Title"] = "Đã xem gần đây";
}

<div class="container rooms-page-container page-container">
    <div class="page-heading page-heading--actions">
        <div>
            <span class="eyebrow">LỊCH SỬ CỦA BẠN</span>
            <h1>Đã xem gần đây</h1>
            <p>Các phòng bạn đã mở gần đây nhất.</p>
        </div>
        <a asp-action="Index" class="sr-btn sr-btn-secondary"><i class="bi bi-search"></i> Tìm thêm phòng</a>
    </div>

    @if (Model.Any())
    {
        <div class="room-grid">
            @foreach (var item in Model)
            {
                var data = new ViewDataDictionary(ViewData);
                <div class="room-grid__item recent-room-item">
                    <span class="recent-room-time"><i class="bi bi-clock-history"></i> @item.LanXemCuoi.ToLocalTime().ToString("HH:mm · dd/MM/yyyy")</span>
                    <partial name="_RoomCard" model="item.Phongtro" view-data="data" />
                </div>
            }
        </div>
    }
    else
    {
        var data = new ViewDataDictionary(ViewData);
        data["EmptyTitle"] = "Bạn chưa xem phòng nào gần đây";
        data["EmptyMessage"] = "Hãy mở chi tiết một phòng để lịch sử được lưu tại đây.";
        data["EmptyActionUrl"] = "/Phongtro";
        data["EmptyActionText"] = "Tìm phòng";
        <partial name="_EmptyState" view-data="data" />
    }
    <partial name="_Pagination" />
</div>
