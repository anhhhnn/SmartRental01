@model IEnumerable<SmartRental.Models.LichSuXem>

@{
    ViewData["Title"] = "Đã xem gần đây";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Đã xem gần đây</h2>
            <p class="text-muted mb-0">Các phòng bạn đã mở gần đây nhất.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Tìm thêm phòng</a>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(item.Phongtro.HinhAnh))
                        {
                            <img src="@item.Phongtro.HinhAnh" alt="@item.Phongtro.TieuDe" class="card-img-top" style="height:220px; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height:220px;">Chưa có hình ảnh</div>
                        }
                        <div class="card-body">
                            <div class="mb-2 d-flex gap-2"><span class="badge @(item.Phongtro.SoLuongPhong > 0 ? "bg-success" : "bg-danger")">@(item.Phongtro.SoLuongPhong > 0 ? "Còn phòng" : "Hết phòng")</span><span class="badge @(item.Phongtro.IsVisible ? "bg-primary" : "bg-secondary")">@(item.Phongtro.IsVisible ? "Hiển thị" : "Đã ẩn")</span></div>
                            <h5 class="card-title fw-bold">@item.Phongtro.TieuDe</h5>
                            <p class="text-danger fw-bold mb-2">@item.Phongtro.Gia.ToString("N0") VNĐ/tháng</p>
                            <p class="mb-2"><strong>Diện tích:</strong> @item.Phongtro.DienTich m²</p>
                            <p class="mb-2"><strong>Địa chỉ:</strong> @item.Phongtro.DiaChi</p>
                            <small class="text-muted">Xem gần nhất: @item.LanXemCuoi.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <div class="card-footer bg-white border-0"><a asp-action="Details" asp-route-id="@item.PhongtroId" class="btn btn-primary w-100">Xem chi tiết</a></div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-5"><h4>Bạn chưa xem phòng nào gần đây.</h4><p class="text-muted">Hãy mở chi tiết một phòng để lịch sử được lưu tại đây.</p><a asp-action="Index" class="btn btn-primary">Tìm phòng</a></div></div>
    }
</div>

<partial name="_Pagination" />
