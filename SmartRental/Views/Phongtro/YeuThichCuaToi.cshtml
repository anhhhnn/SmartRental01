@model IEnumerable<SmartRental.Models.YeuThich>
@{ ViewData["Title"] = "Yêu thích của tôi"; }
<div class="container mt-4 mb-5"><div class="page-heading d-flex justify-content-between align-items-start gap-3"><div><span class="eyebrow">BỘ SƯU TẬP CỦA BẠN</span><h1 class="h2 mb-1">Phòng yêu thích</h1><p class="mb-0">Các phòng bạn đã lưu để xem lại sau.</p></div><a asp-action="Index" class="btn btn-outline-primary">Tìm thêm phòng</a></div>
@if (Model.Any()) { <div class="row g-4">@foreach (var item in Model) { var data = new ViewDataDictionary(ViewData); data["ShowFavorite"] = true; data["Favorite"] = true; <div class="col-md-6 col-lg-4"><partial name="_RoomCard" model="item.Phongtro" view-data="data" /></div> }</div> } else { var data = new ViewDataDictionary(ViewData); data["EmptyTitle"] = "Chưa có phòng yêu thích"; data["EmptyMessage"] = "Lưu các phòng phù hợp để dễ dàng quay lại."; data["EmptyActionUrl"] = "/Phongtro"; data["EmptyActionText"] = "Tìm phòng"; <partial name="_EmptyState" view-data="data" /> }<partial name="_Pagination" /></div>
