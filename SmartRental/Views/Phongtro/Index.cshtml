@model SmartRental.ViewModels.PagedResult<SmartRental.ViewModels.PhongtroSearchItemViewModel>
@{
    ViewData["Title"] = "Tìm phòng trọ";
    var selected = ViewBag.SelectedTienNghiIds as List<int> ?? new();
    var favorites = ViewBag.FavoriteRoomIds as HashSet<int> ?? new();
    var canCreate = User.IsInRole(AppRoles.ChuTro);
    var uid = User.FindFirstValue(ClaimTypes.NameIdentifier);

    const long priceFloor = 400000;
    const long priceCeiling = 10000000;
    const int areaFloor = 10;
    const int areaCeiling = 100;

    var minPriceValue = priceFloor;
    var maxPriceValue = priceCeiling;
    var minAreaValue = areaFloor;
    var maxAreaValue = areaCeiling;
    var selectedArea = Context.Request.Query["khuVuc"].ToString();
    var thaiNguyenAreas = ThaiNguyenAreas.All;
    var aiResult = ViewBag.AiSearchResult as SmartRental.ViewModels.AiSearchResult;
    var aiSearchError = ViewBag.AiSearchError as string;
    var aiQuery = Context.Request.Query["aiQuery"].ToString();

    if (long.TryParse(Context.Request.Query["minPrice"], out var queryMinPrice))
        minPriceValue = Math.Clamp(queryMinPrice, priceFloor, priceCeiling);
    if (long.TryParse(Context.Request.Query["maxPrice"], out var queryMaxPrice))
        maxPriceValue = Math.Clamp(queryMaxPrice, priceFloor, priceCeiling);
    if (int.TryParse(Context.Request.Query["minArea"], out var queryMinArea))
        minAreaValue = Math.Clamp(queryMinArea, areaFloor, areaCeiling);
    if (int.TryParse(Context.Request.Query["maxArea"], out var queryMaxArea))
        maxAreaValue = Math.Clamp(queryMaxArea, areaFloor, areaCeiling);

    minPriceValue = Math.Min(minPriceValue, maxPriceValue);
    minAreaValue = Math.Min(minAreaValue, maxAreaValue);
}
<div class="rooms-page-container">
<section class="search-page-header">
    <div>
        <span class="eyebrow">KHÁM PHÁ SMARTRENTAL</span>
        <h1>Tìm phòng trọ phù hợp</h1>
        <p>Chọn nơi ở theo ngân sách, diện tích và tiện nghi bạn cần.</p>
    </div>
    @if (canCreate)
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Đăng phòng</a>
    }
</section>
<section class="horizontal-filter-card">
    <form asp-action="Index" method="get" class="horizontal-filter-form" role="search" aria-label="Tìm và lọc phòng trọ">
        <input type="hidden" name="sort" value="@ViewBag.Sort" />
        <div class="ai-search-box">
            <div class="ai-search-box__heading">
                <span class="ai-search-box__icon" aria-hidden="true"><i class="bi bi-stars"></i></span>
                <div>
                    <label for="aiQuery">Bạn đang tìm phòng như thế nào?</label>
                    <span>Hãy mô tả tự nhiên, AI sẽ chuyển yêu cầu thành bộ lọc.</span>
                </div>
            </div>
            <div class="ai-search-box__controls">
                <input id="aiQuery" name="aiQuery" type="search" value="@aiQuery" class="form-control"
                       placeholder="VD: Tìm phòng dưới 1,5 triệu cho 2 người ở Tân Thịnh có wifi và điều hòa" />
                <button class="btn btn-ai-search" type="submit" data-ai-submit>
                    <i class="bi bi-stars" data-ai-icon></i>
                    <span data-ai-label>Tìm bằng AI</span>
                </button>
            </div>
        </div>
        <div class="search-filter-row">
            <div class="search-filter-input input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <label class="visually-hidden" for="search">Tên phòng, địa chỉ hoặc khu vực</label>
                <input id="search" name="search" type="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="Tìm theo tên phòng, địa chỉ hoặc khu vực..." />
            </div>
            <button class="btn btn-primary search-submit" type="submit"><i class="bi bi-search me-1"></i>Tìm</button>
        </div>

        <div class="filter-toolbar">
            <div class="filter-select-wrap">
                <i class="bi bi-geo-alt"></i>
                <select id="khuVuc" name="khuVuc" class="form-select" aria-label="Khu vực">
                    <option value="">Tất cả khu vực</option>
                    @foreach (var area in thaiNguyenAreas)
                    {
                        <option value="@area" selected="@(selectedArea == area)">@area</option>
                    }
                </select>
            </div>

            <details class="filter-dropdown">
                <summary><i class="bi bi-cash-coin"></i><span>Khoảng giá</span><i class="bi bi-chevron-down"></i></summary>
                <div class="filter-dropdown-panel filter-range-panel">
                    <div class="range-values" aria-live="polite">
                        <span data-range-min-label>400k</span>
                        <span data-range-max-label>10tr</span>
                    </div>
                    <div class="dual-range" data-min-id="minPrice" data-max-id="maxPrice" data-min="400000" data-max="10000000">
                        <div class="dual-range__track"><span class="dual-range__fill"></span></div>
                        <input class="dual-range__input dual-range__min" type="range" min="400000" max="10000000" step="100000" value="@minPriceValue" aria-label="Giá tối thiểu" />
                        <input class="dual-range__input dual-range__max" type="range" min="400000" max="10000000" step="100000" value="@maxPriceValue" aria-label="Giá tối đa" />
                    </div>
                    <input id="minPrice" type="hidden" name="minPrice" value="@minPriceValue" />
                    <input id="maxPrice" type="hidden" name="maxPrice" value="@maxPriceValue" />
                    <div class="quick-chips" data-min="minPrice" data-max="maxPrice">
                        <button type="button" data-min="400000" data-max="1000000" class="btn btn-sm btn-outline-secondary">400k - 1 triệu</button>
                        <button type="button" data-min="1000000" data-max="2000000" class="btn btn-sm btn-outline-secondary">1 - 2 triệu</button>
                        <button type="button" data-min="2000000" data-max="3000000" class="btn btn-sm btn-outline-secondary">2 - 3 triệu</button>
                        <button type="button" data-min="3000000" data-max="5000000" class="btn btn-sm btn-outline-secondary">3 - 5 triệu</button>
                        <button type="button" data-min="5000000" data-max="10000000" class="btn btn-sm btn-outline-secondary">Trên 5 triệu</button>
                    </div>
                </div>
            </details>

            <details class="filter-dropdown">
                <summary><i class="bi bi-aspect-ratio"></i><span>Diện tích</span><i class="bi bi-chevron-down"></i></summary>
                <div class="filter-dropdown-panel filter-range-panel">
                    <div class="range-values" aria-live="polite">
                        <span data-range-min-label>10m²</span>
                        <span data-range-max-label>100m²</span>
                    </div>
                    <div class="dual-range" data-min-id="minArea" data-max-id="maxArea" data-min="10" data-max="100">
                        <div class="dual-range__track"><span class="dual-range__fill"></span></div>
                        <input class="dual-range__input dual-range__min" type="range" min="10" max="100" step="1" value="@minAreaValue" aria-label="Diện tích tối thiểu" />
                        <input class="dual-range__input dual-range__max" type="range" min="10" max="100" step="1" value="@maxAreaValue" aria-label="Diện tích tối đa" />
                    </div>
                    <input id="minArea" type="hidden" name="minArea" value="@minAreaValue" />
                    <input id="maxArea" type="hidden" name="maxArea" value="@maxAreaValue" />
                    <div class="quick-chips" data-min="minArea" data-max="maxArea">
                        <button type="button" data-min="10" data-max="20" class="btn btn-sm btn-outline-secondary">10 - 20m²</button>
                        <button type="button" data-min="20" data-max="30" class="btn btn-sm btn-outline-secondary">20 - 30m²</button>
                        <button type="button" data-min="30" data-max="40" class="btn btn-sm btn-outline-secondary">30 - 40m²</button>
                        <button type="button" data-min="40" data-max="50" class="btn btn-sm btn-outline-secondary">40 - 50m²</button>
                        <button type="button" data-min="50" data-max="100" class="btn btn-sm btn-outline-secondary">Trên 50m²</button>
                    </div>
                </div>
            </details>

            <details class="filter-dropdown filter-dropdown--wide">
                <summary><i class="bi bi-stars"></i><span>Tiện nghi</span><i class="bi bi-chevron-down"></i></summary>
                <div class="filter-dropdown-panel">
                    <div class="amenity-filter-list amenities-grid">
                        @if (ViewBag.TienNghis != null)
                        {
                            foreach (var x in ViewBag.TienNghis)
                            {
                                <label class="filter-check"><input class="form-check-input" type="checkbox" name="tienNghiIds" value="@x.Id" checked="@selected.Contains(x.Id)" /> <span>@x.TenTienNghi</span></label>
                            }
                        }
                    </div>
                </div>
            </details>

            <details class="filter-dropdown">
                <summary><i class="bi bi-sliders"></i><span>Lọc nâng cao</span><i class="bi bi-chevron-down"></i></summary>
                <div class="filter-dropdown-panel">
                    <label class="form-label" for="status">Trạng thái phòng</label>
                    <select id="status" name="status" class="form-select">
                        <option value="">Tất cả trạng thái</option>
                        <option value="true" selected="@(Context.Request.Query["status"] == "true")">Còn phòng</option>
                        <option value="false" selected="@(Context.Request.Query["status"] == "false")">Hết phòng</option>
                    </select>
                </div>
            </details>

            <div class="filter-select-wrap">
                <i class="bi bi-people"></i>
                <select id="soNguoi" name="soNguoi" class="form-select" aria-label="Số người">
                    <option value="">Số người</option>
                    @for (var people = 1; people <= 4; people++)
                    {
                        <option value="@people" selected="@(Context.Request.Query["soNguoi"] == people.ToString())">@people người</option>
                    }
                </select>
            </div>
            <button class="btn btn-primary filter-apply" type="submit"><i class="bi bi-funnel me-1"></i>Áp dụng</button>
            <a asp-action="Index" class="filter-reset">Xóa bộ lọc</a>
        </div>
    </form>
</section>

@if (!string.IsNullOrWhiteSpace(aiSearchError))
{
    <div class="alert alert-warning ai-search-alert" role="alert">
        <i class="bi bi-exclamation-circle"></i>
        <span>@aiSearchError</span>
    </div>
}
else if (aiResult is not null)
{
    <aside class="ai-search-summary" aria-live="polite">
        <div class="ai-search-summary__title"><i class="bi bi-stars"></i> AI hiểu yêu cầu:</div>
        <ul>
            @if (aiResult.MaxPrice.HasValue)
            {
                <li><strong>Giá tối đa:</strong> @aiResult.MaxPrice.Value.ToString("N0")đ</li>
            }
            @if (aiResult.SoNguoi.HasValue)
            {
                <li><strong>Số người:</strong> @aiResult.SoNguoi</li>
            }
            @if (!string.IsNullOrWhiteSpace(aiResult.KhuVuc))
            {
                <li><strong>Khu vực:</strong> @aiResult.KhuVuc</li>
            }
            @if (!string.IsNullOrWhiteSpace(aiResult.NearPlace))
            {
                <li><strong>Gần:</strong> @aiResult.NearPlace</li>
            }
            @if (aiResult.MaxDistanceKm.HasValue)
            {
                <li><strong>Bán kính:</strong> @aiResult.MaxDistanceKm.Value.ToString("0.##") km</li>
            }
            @if (aiResult.TienNghi.Count > 0)
            {
                <li><strong>Tiện nghi:</strong> @string.Join(", ", aiResult.TienNghi)</li>
            }
        </ul>
    </aside>
}

@if (ViewBag.LandmarkNotFound == true)
{
    <div class="alert alert-warning ai-search-alert" role="alert">
        <i class="bi bi-geo-alt"></i>
        <span>Không tìm thấy địa điểm được yêu cầu trong dữ liệu hệ thống.</span>
    </div>
}
else if (ViewBag.AiNoExactMatch == true)
{
    <div class="alert alert-info ai-search-alert" role="status">
        <i class="bi bi-info-circle"></i>
        <span>Không có phòng khớp hoàn toàn với yêu cầu của bạn.</span>
    </div>
}

<section class="search-results search-results--full">
    <div class="page-heading search-results-heading">
        <div>
            <h2 class="h3 mb-1">Danh sách phòng</h2>
            <p class="mb-0">Tìm thấy <strong>@Model.TotalItems</strong> phòng trọ</p>
        </div>
        <form asp-action="Index" method="get" class="sort-form">
            @foreach (var query in Context.Request.Query.Where(query =>
                !string.Equals(query.Key, "sort", StringComparison.OrdinalIgnoreCase) &&
                !string.Equals(query.Key, "page", StringComparison.OrdinalIgnoreCase)))
            {
                foreach (var value in query.Value)
                {
                    <input type="hidden" name="@query.Key" value="@value" />
                }
            }
            <label for="sort">Sắp xếp</label>
            <select id="sort" name="sort" class="form-select" onchange="this.form.submit()">
                <option value="default" selected="@(ViewBag.Sort == "default")">Mặc định</option>
                <option value="price_asc" selected="@(ViewBag.Sort == "price_asc")">Giá tăng dần</option>
                <option value="price_desc" selected="@(ViewBag.Sort == "price_desc")">Giá giảm dần</option>
            </select>
        </form>
    </div>
    @if (Model.Any())
    {
        <div class="room-grid">
            @foreach (var resultItem in Model)
            {
                var item = resultItem.Phongtro;
                var data = new ViewDataDictionary(ViewData);
                data["ShowFavorite"] = true;
                data["Favorite"] = favorites.Contains(item.Id);
                data["Manage"] = User.IsInRole(AppRoles.Admin) || (uid != null && item.OwnerId == uid);
                data["DistanceKm"] = resultItem.DistanceKm;
                data["NearPlaceName"] = resultItem.NearPlaceName;
                <div class="room-grid__item">
                    <partial name="_RoomCard" model="item" view-data="data" />
                </div>
            }
        </div>
    }
    else
    {
        var data = new ViewDataDictionary(ViewData);
        data["EmptyTitle"] = "Không tìm thấy phòng phù hợp";
        data["EmptyMessage"] = "Hãy điều chỉnh bộ lọc và thử lại.";
        data["EmptyActionUrl"] = "/Phongtro";
        data["EmptyActionText"] = "Xem tất cả phòng";
        <partial name="_EmptyState" view-data="data" />
    }
    <partial name="_Pagination" />
</section>
</div>

<script>
    document.querySelector('.horizontal-filter-form')?.addEventListener('submit', function (event) {
        if (!event.submitter?.matches('[data-ai-submit]')) return;
        const button = event.submitter;
        button.disabled = true;
        button.querySelector('[data-ai-icon]')?.classList.replace('bi-stars', 'spinner-border');
        button.querySelector('[data-ai-icon]')?.classList.add('spinner-border-sm');
        const label = button.querySelector('[data-ai-label]');
        if (label) label.textContent = 'Đang phân tích...';
    });
</script>
