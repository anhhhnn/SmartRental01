@model IEnumerable<SmartRental.Models.Phongtro>
@{ ViewData["Title"] = "Tìm phòng trọ"; var selected = ViewBag.SelectedTienNghiIds as List<int> ?? new(); var favorites = ViewBag.FavoriteRoomIds as HashSet<int> ?? new(); var canCreate = User.IsInRole(AppRoles.ChuTro); var uid = User.FindFirstValue(ClaimTypes.NameIdentifier); }
<section class="search-page-header"><div><span class="eyebrow">KHÁM PHÁ SMARTRENTAL</span><h1>Tìm phòng trọ phù hợp</h1><p>Chọn nơi ở theo ngân sách, diện tích và tiện nghi bạn cần.</p></div>@if (canCreate) { <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Đăng phòng</a> }</section>
<div class="room-search-layout"><aside class="search-sidebar"><div class="d-flex align-items-center justify-content-between mb-3"><h2 class="h5 mb-0">Bộ lọc</h2><a asp-action="Index" class="small">Xóa tất cả</a></div><form asp-action="Index" method="get">
<div class="filter-group"><label class="form-label" for="search">Từ khóa</label><div class="input-group"><span class="input-group-text"><i class="bi bi-search"></i></span><input id="search" name="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="Tên phòng, địa chỉ" /></div></div>
<div class="filter-group"><label class="form-label">Khoảng giá</label><div class="row g-2"><div class="col-6"><input id="minPrice" aria-label="Giá từ" type="number" name="minPrice" value="@Context.Request.Query["minPrice"]" class="form-control" min="0" placeholder="Từ" /></div><div class="col-6"><input id="maxPrice" aria-label="Giá đến" type="number" name="maxPrice" value="@Context.Request.Query["maxPrice"]" class="form-control" min="0" placeholder="Đến" /></div></div><div class="d-flex flex-wrap gap-1 mt-2 quick-chips" data-min="minPrice" data-max="maxPrice"><button type="button" data-min="" data-max="1000000" class="btn btn-sm btn-outline-secondary">Dưới 1 triệu</button><button type="button" data-min="1000000" data-max="2000000" class="btn btn-sm btn-outline-secondary">1 - 2 triệu</button><button type="button" data-min="2000000" data-max="3000000" class="btn btn-sm btn-outline-secondary">2 - 3 triệu</button><button type="button" data-min="3000000" data-max="5000000" class="btn btn-sm btn-outline-secondary">3 - 5 triệu</button><button type="button" data-min="5000000" data-max="" class="btn btn-sm btn-outline-secondary">Trên 5 triệu</button></div></div>
<div class="filter-group"><label class="form-label">Diện tích (m²)</label><div class="row g-2"><div class="col-6"><input id="minArea" aria-label="Diện tích từ" type="number" name="minArea" value="@Context.Request.Query["minArea"]" class="form-control" min="0" step=".1" placeholder="Từ" /></div><div class="col-6"><input id="maxArea" aria-label="Diện tích đến" type="number" name="maxArea" value="@Context.Request.Query["maxArea"]" class="form-control" min="0" step=".1" placeholder="Đến" /></div></div><div class="d-flex flex-wrap gap-1 mt-2 quick-chips" data-min="minArea" data-max="maxArea"><button type="button" data-min="" data-max="20" class="btn btn-sm btn-outline-secondary">Dưới 20 m²</button><button type="button" data-min="20" data-max="30" class="btn btn-sm btn-outline-secondary">20 - 30 m²</button><button type="button" data-min="30" data-max="40" class="btn btn-sm btn-outline-secondary">30 - 40 m²</button><button type="button" data-min="40" data-max="50" class="btn btn-sm btn-outline-secondary">40 - 50 m²</button><button type="button" data-min="50" data-max="" class="btn btn-sm btn-outline-secondary">Trên 50 m²</button></div></div>
<div class="filter-group"><label class="form-label" for="status">Trạng thái</label><select id="status" name="status" class="form-select"><option value="">Tất cả</option><option value="true" selected="@(Context.Request.Query["status"] == "true")">Đang hoạt động</option><option value="false" selected="@(Context.Request.Query["status"] == "false")">Tạm ẩn</option></select></div>
<div class="filter-group"><label class="form-label d-block">Tiện nghi</label><div class="amenity-filter-list">@if (ViewBag.TienNghis != null) { foreach (var x in ViewBag.TienNghis) { <label class="filter-check"><input class="form-check-input" type="checkbox" name="tienNghiIds" value="@x.Id" checked="@selected.Contains(x.Id)" /> <span>@x.TenTienNghi</span></label> } }</div></div><button class="btn btn-primary w-100" type="submit"><i class="bi bi-funnel me-1"></i>Áp dụng bộ lọc</button></form></aside>
<section class="search-results"><div class="page-heading"><h2 class="h3 mb-1">Danh sách phòng</h2><p class="mb-0">Tìm thấy <strong>@Model.Count()</strong> phòng trọ</p></div>@if (Model.Any()) { <div class="row g-4">@foreach (var item in Model) { var data = new ViewDataDictionary(ViewData); data["ShowFavorite"] = true; data["Favorite"] = favorites.Contains(item.Id); data["Manage"] = User.IsInRole(AppRoles.Admin) || (uid != null && item.OwnerId == uid); <div class="col-md-6 col-xl-4"><partial name="_RoomCard" model="item" view-data="data" /></div> }</div> } else { var data = new ViewDataDictionary(ViewData); data["EmptyTitle"] = "Không tìm thấy phòng phù hợp"; data["EmptyMessage"] = "Hãy điều chỉnh bộ lọc và thử lại."; data["EmptyActionUrl"] = "/Phongtro"; data["EmptyActionText"] = "Xem tất cả phòng"; <partial name="_EmptyState" view-data="data" /> }<partial name="_Pagination" /></section></div>
