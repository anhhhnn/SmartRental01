@model IEnumerable<SmartRental.Models.ThongBao>
@{ViewData["Title"]="Thông báo";}<div class="container py-4"><h1 class="h3">Thông báo</h1><div class="card">@foreach(var n in Model){<form asp-action="Read" method="post" class="border-bottom p-3 @(n.DaDoc?"":"bg-light")"><input type="hidden" name="id" value="@n.Id"/><button class="btn btn-link text-start text-decoration-none p-0"><strong>@n.TieuDe</strong><div>@n.NoiDung</div><small class="text-muted">@n.NgayTao.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></button></form>}@if(!Model.Any()){<div class="p-4 text-muted">Chưa có thông báo.</div>}</div></div>
