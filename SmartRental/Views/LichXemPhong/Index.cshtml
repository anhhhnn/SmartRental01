@model IEnumerable<SmartRental.Models.LichXemPhong>
@using SmartRental.Models
@{ViewData["Title"]="Lịch xem phòng";var owner=(bool)(ViewBag.IsOwner??false);string StatusText(string s)=>s switch{TrangThaiLich.ChoXacNhan=>"Chờ xác nhận",TrangThaiLich.DaDongY=>"Đã đồng ý",TrangThaiLich.BaoBan=>"Báo bận",TrangThaiLich.DaHuy=>"Đã hủy",_=>s};}
<div class="container page-container"><div class="page-heading"><span class="eyebrow">QUẢN LÝ LỊCH HẸN</span><h1>Lịch xem phòng</h1><p>@(owner?"Xác nhận các yêu cầu xem phòng từ người thuê.":"Theo dõi các lịch xem phòng bạn đã đặt.")</p></div>
@if(Model.Any()){<div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Phòng</th><th>Người đặt</th><th>Thời gian</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><a class="fw-bold" asp-controller="Phongtro" asp-action="Details" asp-route-id="@x.PhongtroId">@x.Phongtro.TieuDe</a></td><td>@x.HoTen</td><td><i class="bi bi-calendar3 me-1 text-muted"></i>@x.ThoiGianXem.ToString("HH:mm · dd/MM/yyyy")</td><td><span class="booking-status booking-status--@x.TrangThai">@StatusText(x.TrangThai)</span></td><td class="text-end">@if(owner&&x.TrangThai==TrangThaiLich.ChoXacNhan){<form asp-action="Respond" method="post" class="d-inline-flex gap-1"><input name="id" type="hidden" value="@x.Id"/><button name="action" value="accept" class="sr-btn sr-btn-accent sr-btn-sm">Đồng ý</button><button name="action" value="busy" class="sr-btn sr-btn-secondary sr-btn-sm">Báo bận</button></form>}else if(!owner&&(x.TrangThai==TrangThaiLich.ChoXacNhan||x.TrangThai==TrangThaiLich.DaDongY)){<form asp-action="Cancel" method="post"><input name="id" type="hidden" value="@x.Id"/><button class="sr-btn sr-btn-danger sr-btn-sm">Hủy</button></form>}</td></tr>}</tbody></table></div></div>}else{var data=new ViewDataDictionary(ViewData);data["EmptyTitle"]="Chưa có lịch xem phòng";data["EmptyMessage"]=owner?"Yêu cầu xem phòng mới sẽ xuất hiện tại đây.":"Bạn có thể đặt lịch ngay từ trang chi tiết phòng.";data["EmptyActionUrl"]="/Phongtro";data["EmptyActionText"]="Tìm phòng";<partial name="_EmptyState" view-data="data"/>}</div>
