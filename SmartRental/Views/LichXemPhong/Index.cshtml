@model IEnumerable<SmartRental.Models.LichXemPhong>
@using SmartRental.Models
@{ViewData["Title"]="Lịch xem phòng";var owner=(bool)(ViewBag.IsOwner??false);}<div class="container py-4"><h1 class="h3">Lịch xem phòng</h1><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Phòng</th><th>Người đặt</th><th>Thời gian</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Phongtro.TieuDe</td><td>@x.HoTen</td><td>@x.ThoiGianXem.ToString("HH:mm dd/MM/yyyy")</td><td>@x.TrangThai</td><td>@if(owner&&x.TrangThai==TrangThaiLich.ChoXacNhan){<form asp-action="Respond" method="post" class="d-inline"><input name="id" type="hidden" value="@x.Id"/><button name="action" value="accept" class="btn btn-sm btn-success">Đồng ý</button><button name="action" value="busy" class="btn btn-sm btn-outline-warning">Báo bận</button></form>}else if(!owner&&(x.TrangThai==TrangThaiLich.ChoXacNhan||x.TrangThai==TrangThaiLich.DaDongY)){<form asp-action="Cancel" method="post"><input name="id" type="hidden" value="@x.Id"/><button class="btn btn-sm btn-outline-danger">Hủy</button></form>}</td></tr>}@if(!Model.Any()){<tr><td colspan="5" class="text-muted">Chưa có lịch xem.</td></tr>}</tbody></table></div></div></div>
