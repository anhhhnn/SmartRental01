@model IEnumerable<SmartRental.ViewModels.Admin.AdminUserListItemViewModel>
@using Microsoft.AspNetCore.Identity
@inject UserManager<SmartRental.Models.ApplicationUser> UserManager
@{ ViewData["Title"] = "Người dùng"; Layout = "_AdminLayout"; var currentUserId = UserManager.GetUserId(User); }
<h2 class="mb-4">Quản lý người dùng</h2><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Email</th><th>Họ tên</th><th>Số điện thoại</th><th>Role</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach (var user in Model) { <tr><td>@user.Email</td><td>@(user.HoTen ?? "—")</td><td>@(user.PhoneNumber ?? "—")</td><td>@string.Join(", ", user.Roles)</td><td><span class="badge text-bg-@(user.IsLocked ? "secondary" : "success")">@(user.IsLocked ? "Đã khóa" : "Hoạt động")</span></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="UserDetails" asp-route-id="@user.Id">Chi tiết</a> <form class="d-inline" asp-action="ToggleLock" method="post"><input type="hidden" name="id" value="@user.Id" /><button class="btn btn-sm btn-outline-@(user.IsLocked ? "success" : "warning")" type="submit">@(user.IsLocked ? "Mở khóa" : "Khóa")</button></form>@if(user.Id != currentUserId){ <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteUser-@user.Id">Xóa</button><div class="modal fade" id="deleteUser-@user.Id" tabindex="-1"><div class="modal-dialog"><form asp-action="DeleteUser" method="post" class="modal-content"><div class="modal-header"><h5 class="modal-title">Xóa tài khoản</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">Xóa tài khoản này sẽ xóa toàn bộ dữ liệu liên quan.</div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button><input type="hidden" name="id" value="@user.Id"/><button class="btn btn-danger">Xóa tài khoản</button></div></form></div></div>}</td></tr> }
</tbody></table></div></div>
