@model IEnumerable<SmartRental.ViewModels.Admin.AdminFavoriteViewModel>
@{ ViewData["Title"] = "Yêu thích"; Layout = "_AdminLayout"; var byRoom = ViewBag.FavoritesByRoom as IEnumerable<dynamic>; }
<h2 class="mb-4">Thống kê yêu thích</h2>
<div class="row g-4 mb-4"><div class="col-lg-5"><div class="card border-0 shadow-sm"><div class="card-body"><h5>Yêu thích theo phòng</h5><ul class="list-group list-group-flush">@if (byRoom != null) { foreach (var item in byRoom) { <li class="list-group-item d-flex justify-content-between"><a asp-controller="Phongtro" asp-action="Details" asp-route-id="@item.PhongtroId">@item.TieuDe</a><span class="badge text-bg-primary rounded-pill">@item.Count</span></li> } }</ul></div></div></div></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Người dùng</th><th>Phòng trọ</th><th>Ngày thêm</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.UserName<br /><small class="text-muted">@item.UserEmail</small></td><td><a asp-controller="Phongtro" asp-action="Details" asp-route-id="@item.PhongtroId">@item.RoomTitle</a></td><td>@item.NgayThem.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr> }</tbody></table></div></div>
