@model SmartRental.ViewModels.Admin.AdminDashboardViewModel
@{ ViewData["Title"] = "Dashboard"; Layout = "_AdminLayout"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="mb-1">Dashboard</h2><p class="text-muted mb-0">Tổng quan hệ thống SmartRental</p></div></div>
<div class="row g-3">
    @{ var cards = new[] { ("Tổng người dùng", Model.TotalUsers, "primary"), ("Chủ trọ", Model.TotalLandlords, "success"), ("Người thuê", Model.TotalTenants, "info"), ("Tổng phòng trọ", Model.TotalRooms, "dark"), ("Phòng hoạt động", Model.ActiveRooms, "success"), ("Phòng tạm ẩn", Model.HiddenRooms, "secondary"), ("Lượt yêu thích", Model.TotalFavorites, "danger"), ("Tiện nghi", Model.TotalAmenities, "warning") }; }
    @foreach (var card in cards) { <div class="col-sm-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><div class="text-muted">@card.Item1</div><div class="fs-2 fw-bold text-@card.Item3">@card.Item2</div></div></div></div> }
</div>
