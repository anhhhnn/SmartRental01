@model IEnumerable<SmartRental.ViewModels.Admin.AdminRoomViewModel>
@{ ViewData["Title"] = "Phòng trọ"; Layout = "_AdminLayout"; }
<h2 class="mb-4">Quản lý phòng trọ</h2>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Ảnh</th><th>Tiêu đề</th><th>Giá</th><th>Diện tích</th><th>Chủ phòng</th><th>Tình trạng phòng</th><th>Hiển thị tin</th><th></th></tr></thead><tbody>
@foreach (var room in Model) { <tr><td>@if (!string.IsNullOrWhiteSpace(room.HinhAnh)) { <img src="@room.HinhAnh" alt="" width="72" height="52" style="object-fit:cover" class="rounded" /> }</td><td><div>@room.TieuDe</div><small class="text-muted">@room.FavoriteCount lượt yêu thích</small></td><td>@room.Gia.ToString("N0") VNĐ</td><td>@room.DienTich m²</td><td>@room.OwnerName</td><td><span class="badge text-bg-@(room.SoLuongPhong > 0 ? "success" : "danger")">@(room.SoLuongPhong > 0 ? "Còn phòng" : "Hết phòng")</span></td><td><span class="badge text-bg-@(room.IsVisible ? "success" : "secondary")">@(room.IsVisible ? "Đang hiển thị" : "Đã ẩn")</span></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-controller="Phongtro" asp-action="Details" asp-route-id="@room.Id">Xem</a> <a class="btn btn-sm btn-outline-warning" asp-controller="Phongtro" asp-action="Edit" asp-route-id="@room.Id">Sửa</a> <form class="d-inline" asp-action="ToggleRoomVisibility" method="post"><input type="hidden" name="id" value="@room.Id" /><button type="submit" class="btn btn-sm btn-outline-secondary">@(room.IsVisible ? "Ẩn" : "Hiện")</button></form> <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteRoom-@room.Id">Xóa</button><div class="modal fade" id="deleteRoom-@room.Id" tabindex="-1"><div class="modal-dialog"><form asp-action="DeleteRoom" method="post" class="modal-content"><div class="modal-header"><h5 class="modal-title">Xóa phòng trọ</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">Xóa <strong>@room.TieuDe</strong>? Dữ liệu liên quan sẽ được xử lý an toàn; lịch sử chat vẫn được giữ.</div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button><input type="hidden" name="id" value="@room.Id" /><button class="btn btn-danger">Xóa phòng</button></div></form></div></div></td></tr> }
</tbody></table></div></div>
