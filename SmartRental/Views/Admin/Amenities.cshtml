@model IEnumerable<SmartRental.Models.TienNghi>
@{ ViewData["Title"] = "Tiện nghi"; Layout = "_AdminLayout"; }
<h2 class="mb-4">Quản lý tiện nghi</h2>
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><form asp-action="CreateAmenity" method="post" class="row g-2"><div class="col-md-8"><input name="tenTienNghi" class="form-control" maxlength="100" placeholder="Tên tiện nghi mới" required /></div><div class="col-md-auto"><button class="btn btn-primary" type="submit">Thêm tiện nghi</button></div></form></div></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Tên tiện nghi</th><th class="text-end">Thao tác</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><form asp-action="EditAmenity" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@item.Id" /><input name="tenTienNghi" class="form-control" maxlength="100" value="@item.TenTienNghi" required /><button class="btn btn-outline-warning text-nowrap" type="submit">Lưu</button></form></td><td class="text-end"><form asp-action="DeleteAmenity" method="post"><input type="hidden" name="id" value="@item.Id" /><button type="submit" class="btn btn-outline-danger" onclick="return confirm('Xóa tiện nghi này khỏi tất cả phòng đang dùng?');">Xóa</button></form></td></tr> }</tbody></table></div></div>
