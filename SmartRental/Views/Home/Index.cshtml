@using SmartRental.Models
@{ ViewData["Title"] = "Tìm phòng trọ thông minh"; var featured = ViewBag.FeaturedRooms as IEnumerable<Phongtro> ?? Enumerable.Empty<Phongtro>(); }
<div class="container"><section class="landing-hero"><div class="hero-copy"><span class="hero-kicker"><i class="bi bi-stars"></i> SmartRental · tìm đúng nơi ở</span><h1>Tìm phòng trọ<br /><span>phù hợp với bạn</span></h1><p>Khám phá không gian sống phù hợp với nhu cầu, ngân sách và khu vực bạn mong muốn.</p></div><form class="hero-search-box" asp-controller="Phongtro" asp-action="Index" method="get"><label class="visually-hidden" for="hero-search">Tìm khu vực hoặc tên phòng</label><i class="bi bi-search"></i><input id="hero-search" name="search" placeholder="Tìm khu vực, tên phòng trọ..." /><button class="btn btn-primary" type="submit">Tìm phòng</button><div class="quick-chips"><span>Gợi ý:</span><a asp-controller="Phongtro" asp-action="Index" asp-route-search="ICTU">Gần ICTU</a><a asp-controller="Phongtro" asp-action="Index" asp-route-minPrice="1000000" asp-route-maxPrice="3000000">1–3 triệu</a><a asp-controller="Phongtro" asp-action="Index" asp-route-minArea="20">Từ 20m²</a></div></form></section><section class="stats-grid" aria-label="Thống kê SmartRental"><div><strong>@ViewBag.TotalRooms</strong><span>Phòng trọ</span></div><div><strong>@ViewBag.TotalFavorites</strong><span>Lượt yêu thích</span></div><div><strong>@ViewBag.ActiveRooms</strong><span>Phòng đang hoạt động</span></div></section><section class="home-section"><div class="section-heading"><div><span class="eyebrow">KHÁM PHÁ NHANH</span><h2>Tìm theo nhu cầu của bạn</h2></div><a asp-controller="Phongtro" asp-action="Index" class="link-arrow">Tìm kiếm nâng cao <i class="bi bi-arrow-right"></i></a></div><div class="quick-filter-grid"><a asp-controller="Phongtro" asp-action="Index"><i class="bi bi-geo-alt"></i>Khu vực</a><a asp-controller="Phongtro" asp-action="Index"><i class="bi bi-cash-stack"></i>Khoảng giá</a><a asp-controller="Phongtro" asp-action="Index"><i class="bi bi-aspect-ratio"></i>Diện tích</a><a asp-controller="Phongtro" asp-action="Index"><i class="bi bi-house-heart"></i>Tiện nghi</a></div></section><section class="home-section"><div class="section-heading"><div><span class="eyebrow">PHÒNG MỚI</span><h2>Phòng trọ nổi bật</h2></div><a asp-controller="Phongtro" asp-action="Index" class="link-arrow">Xem tất cả <i class="bi bi-arrow-right"></i></a></div>@if(featured.Any()){<div class="row g-4">@foreach(var room in featured){var data = new ViewDataDictionary(ViewData); data["ShowFavorite"] = User.Identity?.IsAuthenticated == true;<div class="col-sm-6 col-lg-3"><partial name="_RoomCard" model="room" view-data="data" /></div>}</div>}else{var data = new ViewDataDictionary(ViewData); data["EmptyTitle"] = "Chưa có phòng nổi bật"; data["EmptyMessage"] = "Các phòng đang hoạt động sẽ xuất hiện tại đây."; data["EmptyActionUrl"] = "/Phongtro"; data["EmptyActionText"] = "Tìm phòng"; <partial name="_EmptyState" view-data="data"/>}</section><section class="why-section"><span class="eyebrow text-mint">SMARTER RENTING</span><h2>Tại sao chọn SmartRental?</h2><div class="row g-4 mt-1"><div class="col-md-3"><i class="bi bi-lightning-charge"></i><h3>Tìm phòng nhanh</h3><p>Thông tin rõ ràng, cập nhật tập trung.</p></div><div class="col-md-3"><i class="bi bi-sliders"></i><h3>Lọc thông minh</h3><p>Dễ dàng tìm theo giá, diện tích và tiện nghi.</p></div><div class="col-md-3"><i class="bi bi-heart"></i><h3>Lưu yêu thích</h3><p>Đánh dấu và quay lại phòng bạn quan tâm.</p></div><div class="col-md-3"><i class="bi bi-stars"></i><h3>Gợi ý AI</h3><p>Sẵn sàng hỗ trợ tìm phòng theo nhu cầu.</p></div></div></section></div>
